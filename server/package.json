{
  "name": "chatterbuilt-mail-server",
  "version": "0.10.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:imap-live": "vitest run --config vitest.live.config.ts",
    "build": "tsc && node --input-type=module -e \"import { cpSync } from 'node:fs'; cpSync('migrations', 'dist/migrations', { recursive: true })\" && node scripts/build-app.mjs",
    "dev": "tsx src/dev.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "imapflow": "^2.10.0",
    "mailparser": "^3.14.2",
    "nodemailer": "^10.3.1",
    "pg": "^8.16.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.15.6",
    "@types/smtp-server": "^3.5.13",
    "eslint": "^9.39.1",
    "smtp-server": "^3.21.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    }
  }
}
