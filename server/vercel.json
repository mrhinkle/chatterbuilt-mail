{
  "rewrites": [
    { "source": "/app/api/call", "destination": "/api/app-call" },
    { "source": "/app/api/sample", "destination": "/api/app-sample" },
    { "source": "/app/manifest.webmanifest", "destination": "/api/app-manifest" },
    { "source": "/app/icon.svg", "destination": "/api/app-icon" },
    { "source": "/app", "destination": "/api/app" },
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/authorize", "destination": "/api/authorize" },
    { "source": "/token", "destination": "/api/token" },
    { "source": "/register", "destination": "/api/register" },
    { "source": "/signin", "destination": "/api/signin" },
    { "source": "/setup", "destination": "/api/setup" },
    { "source": "/.well-known/oauth-protected-resource/mcp", "destination": "/api/oauth-protected-resource-mcp" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/oauth-protected-resource" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/oauth-authorization-server" },
    { "source": "/connect/microsoft/device/status", "destination": "/api/connect/microsoft/device/status" },
    { "source": "/connect/microsoft/callback", "destination": "/api/connect/microsoft/callback" },
    { "source": "/connect/microsoft/disconnect", "destination": "/api/connect/microsoft/disconnect" },
    { "source": "/connect/microsoft", "destination": "/api/connect/microsoft" },
    { "source": "/connect/google/callback", "destination": "/api/connect/google/callback" },
    { "source": "/connect/google/disconnect", "destination": "/api/connect/google/disconnect" },
    { "source": "/connect/google/client", "destination": "/api/connect/google/client" },
    { "source": "/connect/google", "destination": "/api/connect/google" },
    { "source": "/connect/microsoft/client", "destination": "/api/connect/microsoft/client" },
    { "source": "/connect/imap", "destination": "/api/connect/imap" },
    { "source": "/connect/other", "destination": "/api/connect/other" },
    { "source": "/connect", "destination": "/api/connect" }
  ],
  "crons": [
    { "path": "/api/cron/sync", "schedule": "0 13 * * *" },
    { "path": "/api/cron/jobs", "schedule": "0 13 * * *" }
  ]
}
